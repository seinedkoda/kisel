[Icon Theme]
Name=Papirus
Comment=Papirus icon theme
Inherits=breeze,hicolor

FollowsColorScheme=true

# Directory list
Directories=16x16/actions,16x16/apps,16x16/symbolic/apps,64x64/mimetypes

[16x16/actions]
Context=Actions
Size=16
Type=Fixed

[16x16/apps]
Context=Applications
Size=16
Type=Fixed

[16x16/symbolic/apps]
Context=Applications
Size=16
Type=Fixed

[64x64/mimetypes]
Context=MimeTypes
Size=64
Type=Fixed
