<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.seinedkoda.kisel</id>

  <name>Kisel</name>
  <developer id="io.github.seinedkoda">
    <name translate="no">Seined Koda</name>
  </developer>
  <summary>Efficient launch of Windows programs</summary>
  <summary xml:lang="ru">Эффективный запуск Windows программ</summary>
  <url type="homepage">https://github.com/seinedkoda/kisel</url>
  <url type="bugtracker">https://github.com/seinedkoda/kisel/issues</url>
  <url type="donation">https://boosty.to/seinedk/donate</url>

  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <branding>
    <color type="primary" scheme_preference="light">#f5f5f5</color>
    <color type="primary" scheme_preference="dark">#1b5583</color>
  </branding>

  <description>
    <p>The easiest way to launch Windows games and apps. No complicated launchers or menus, just launch.</p>
    <p xml:lang="ru">Самый простой способ запуска игр и приложений для Windows. Без сложных лаунчеров и множества меню, просто запускай.</p>
    <p>Features:</p>
    <p xml:lang="ru">Возможности:</p>
    <ul>
      <li>Launching games without Steam</li>
      <li xml:lang="ru">Запуск игр без Steam</li>
      <li>Managing Compatibility Tools</li>
      <li xml:lang="ru">Управление средствами совместимости</li>
      <li>Prefix management</li>
      <li xml:lang="ru">Управление префиксами</li>
      <li>Desktop shortcuts</li>
      <li xml:lang="ru">Создание ярлыков</li>
      <li>Installing components from winetricks</li>
      <li xml:lang="ru">Установка компонентов через winetricks</li>
      <li>OnlineFix Support</li>
      <li xml:lang="ru">Поддержка OnlineFix</li>
    </ul>
    <p>Available settings:</p>
    <p xml:lang="ru">Доступные настройки:</p>
    <ul>
      <li>Runtime auto-update</li>
      <li xml:lang="ru">Автоматическое обновление среды выполнения</li>
      <li>Using Steam or umu-launcher</li>
      <li xml:lang="ru">Использование Steam или umu-launcher</li>
      <li>MangoHud</li>
      <li>OBS Vulkan Game Capture</li>
      <li>Xalia</li>
      <li>NVAPI</li>
      <li>Wayland driver</li>
      <li xml:lang="ru">Драйвер Wayland</li>
      <li>HDR</li>
      <li>SDL Input</li>
      <li>Steam Environment</li>
      <li xml:lang="ru">Использование среды Steam</li>
      <li>WOW64</li>
      <li>OnlineFix</li>
      <li>And some others...</li>
      <li xml:lang="ru">И ещё некоторые...</li>
    </ul>
  </description>

  <content_rating type="oars-1.1"/>
  <categories>
    <category>Utility</category>
    <category>Game</category>
  </categories>
  <provides>
    <mediatype>application/x-ms-dos-executable</mediatype>
