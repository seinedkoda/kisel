# Maintainer: Seined Koda <seinedk@gmail.com>
pkgname=kisel
pkgver=1.1.0
pkgrel=1
pkgdesc="Efficient launch of Windows programs"
arch=('x86_64')
url="https://github.com/seinedkoda/kisel"
license=('GPL-3.0-or-later')

options=('!debug' 'strip')

depends=(
  'qt6-base'
  'umu-launcher'
  'icoutils'
)

optdepends=(
  'winetricks: Additional scripts for working with Wine prefix'
  'mangohud: Overlay for monitoring FPS, temperature, CPU/GPU load'
  'lib32-mangohud: 32-bit overlay support for older 32-bit games'
  'obs-vkcapture: Vulkan game capture plugin for OBS'
)

makedepends=(
  'cmake'
  'ninja'
  'qt6-tools'
)

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('1923d0d08ab9db6d457261f3c5a1bff0a31fdee1f702787a2125810fa5b8fc1f')

build() {
  cmake -B build -S "${pkgname}-${pkgver}" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
